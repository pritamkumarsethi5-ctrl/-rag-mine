# RAG-Mine environment (all optional). SIMULATION ONLY.
RAGMINE_AUTOSTART=1          # start the simulation clock on boot
RAGMINE_PERSIST=0            # 1 = store history in SQLite (backend/data/ragmine.db)
ENABLE_HARDWARE_ADAPTER=0    # MUST stay 0; the ESP32 adapter is a disabled stub
RAGMINE_CORS=http://localhost:5173,http://127.0.0.1:5173
